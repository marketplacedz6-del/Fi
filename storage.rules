rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // الصور المرفوعة (المنتجات، الشعار، الهيرو) تُقرأ للجميع
    // لكن الرفع/التعديل محصور على المدير المسجّل (Firebase Auth)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
