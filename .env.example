# Unlimited comma-separated tracking IDs (leave blank to disable a provider)
VITE_META_PIXEL_IDS=
VITE_TIKTOK_PIXEL_IDS=
VITE_GOOGLE_TAG_IDS=
VITE_PINTEREST_TAG_IDS=
VITE_SNAPCHAT_PIXEL_IDS=

# Order/CRM API endpoint. Receives JSON by POST.
VITE_ORDER_API_URL=

# Comma-separated delivery provider/webhook endpoints.
VITE_DELIVERY_WEBHOOK_URLS=

# Comma-separated Google Apps Script web-app URLs (supports the requested 30 sheets and more).
VITE_GOOGLE_SHEETS_WEBHOOK_URLS=
